{
  "id": "one-column-centred-plate",
  "name": "centred_plate_one_column",
  "description": "A centred letterhead rather than a form: the name centred under a double rule, section labels centred over a left-aligned column, and each entry led by the EMPLOYER with the role beneath it in italic. Times New Roman, teal accent. Sections run summary, education, skills, experience.",
  "disabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n<style>\n@page{margin:0.6in 0.5in}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{background:#ffffff}\nbody{font-family:'Times New Roman',Times,Georgia,serif;font-size:11pt;line-height:1.45;color:#1a1a1a}\n/* THE DEVICE: a centred masthead under a double rule, and centred section\n   labels over a left-aligned column - the shape of a printed letterhead rather\n   than of a form. */\n.header{text-align:center;padding-bottom:7px;border-bottom:3px double #115e59;margin-bottom:14px}\n.name{font-size:23pt;font-weight:700;letter-spacing:0.5px;line-height:1.15}\n.headline{font-size:12pt;font-style:italic;color:#115e59;margin-top:3px}\n.contact{font-size:9.5pt;margin-top:6px}\n.section{margin-bottom:13px}\n.section-title{font-size:10.5pt;font-weight:700;text-transform:uppercase;letter-spacing:1.6px;\n  text-align:center;padding-bottom:3px;border-bottom:1px solid #cbd5d5;margin-bottom:7px}\n.summary-text{text-align:left}\n.skill-category{margin-bottom:4px}\n.skill-category-title,.skill-category-skills{color:#1a1a1a}\n.skill-category-title{font-weight:700;font-size:10pt;text-transform:uppercase;letter-spacing:0.5px}\n.skill-category-skills{font-weight:400;letter-spacing:normal}\n/* ...and the EMPLOYER leads each entry, with the role under it in italic. Every\n   other template in this set opens with the role; a reader scanning this one is\n   scanning a list of companies. */\n.exp-item{margin-bottom:10px}\n.exp-item:last-child{margin-bottom:0}\n.company-name{font-weight:700;font-size:11.5pt;color:#115e59}\n.job-title{font-style:italic;font-size:11pt;margin-top:1px}\n.job-meta{font-size:9.5pt;color:#44403c;margin-top:1px}\nul.achievements{margin:4px 0 0 18px}\nul.achievements li{margin-bottom:3px}\n.edu-item,.cert-item{margin-bottom:6px}\n.edu-item:last-child,.cert-item:last-child{margin-bottom:0}\n.edu-institution{font-weight:700;color:#115e59}\n.edu-degree{font-style:italic}\n.edu-meta{font-size:9.5pt;color:#44403c}\n</style>\n</head>\n<body>\n<div class=\"header\">\n<div class=\"name\">{{name}}</div>\n<div class=\"headline\">{{title}}</div>\n<div class=\"contact\">{{contact.phone}} &#8226; {{contact.email}}{{#if contact.linkedin}} &#8226; {{contact.linkedin}}{{/if}}{{#if contact.github}} &#8226; {{contact.github}}{{/if}}{{#if contact.portfolio}} &#8226; {{contact.portfolio}}{{/if}} &#8226; {{contact.location}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Profile</div>\n<div class=\"summary-text\">{{summary}}</div>\n</div>\n\n<div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"section-title\">Education</div>\n{{#each education}}\n<div class=\"edu-item\">\n<div class=\"edu-institution\">{{institution}}</div>\n<div class=\"edu-degree\">{{degree}}</div>\n<div class=\"edu-meta\">{{startDate}} - {{endDate}}{{#if location}} &#8226; {{location}}{{/if}}{{#if gpa}} &#8226; GPA: {{gpa}}{{/if}}</div>\n</div>\n{{/each}}\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Skills</div>\n<div class=\"skills-line\">{{#if skillCategories.[0].category}}{{#each skillCategories}}<div class=\"skill-category\"><div class=\"skill-category-title\">{{category}}</div><div class=\"skill-category-skills\">{{join skills \", \"}}</div></div>{{/each}}{{else}}{{#if hardSkills.length}}{{#each hardSkills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{/if}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Professional Experience</div>\n{{#each experience}}\n<div class=\"exp-item\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"company-name\">{{company}}</div>\n<div class=\"job-title\">{{title}}</div>\n<div class=\"job-meta\">{{startDate}} - {{endDate}}{{#if location}} &#8226; {{location}}{{/if}}</div>\n</div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n</div>\n{{/each}}\n</div>\n\n{{#if certifications.length}}\n<div class=\"section\">\n<div class=\"section-title\">Certifications</div>\n{{#each certifications}}\n<div class=\"cert-item\"><span class=\"edu-institution\">{{name}}</span>{{#if issuer}} &#8226; {{issuer}}{{/if}}{{#if date}} &#8226; {{date}}{{/if}}</div>\n{{/each}}\n</div>\n{{/if}}\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "education",
    "hardSkills",
    "experience",
    "certifications"
  ],
  "createdAt": "2026-10-12T04:08:53.123Z",
  "updatedAt": "2026-10-14T12:19:05.014203Z"
}
