{
  "id": "one-column-modern-blue",
  "name": "modern_blue_one_column",
  "description": "One column, in the shape of the operator's reference: a large grey name, a blue headline, contact icons, section headings over a full rule, and each entry as title, organisation and a dated meta line separated by a dashed hairline. Sections run summary, education, skills, experience; there is no Key Achievements block. The reference's grey and blue are darkened to the contrast body text needs.",
  "disabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n<style>\n@page{margin:0.5in 0.6in}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{background:#ffffff}\nbody{font-family:'Segoe UI',Calibri,Arial,Helvetica,sans-serif;font-size:10.5pt;line-height:1.45;color:#111827}\n.header{margin-bottom:14px}\n.name{font-size:26pt;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#4b5563;line-height:1.05}\n.headline{font-size:13pt;font-weight:700;color:#1d4ed8;margin-top:4px}\n.contact{font-size:9.5pt;color:#4b5563;margin-top:7px}\n.contact span{margin-right:14px;white-space:nowrap}\n.section{margin-bottom:13px}\n.section-title{font-size:11.5pt;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:#0f172a;border-bottom:2px solid #0f172a;padding-bottom:2px;margin-bottom:7px}\n.summary-text{color:#374151}\n/* The model's groups. Pinned black so the six render-time looks cannot tint\n   them into the page's blue, which belongs to the organisations. */\n.skill-category{margin-bottom:4px}\n.skill-category-title,.skill-category-skills{color:#111827}\n.skill-category-title{font-weight:700;text-transform:uppercase;letter-spacing:0.4px}\n.entry{padding-bottom:7px;margin-bottom:7px;border-bottom:1px dashed #d1d5db}\n.entry:last-child{border-bottom:0;padding-bottom:0;margin-bottom:0}\n.entry-title{font-size:11pt;font-weight:700;color:#4b5563}\n.entry-org{font-size:10.5pt;font-weight:700;color:#1d4ed8;margin-top:1px}\n.entry-meta{font-size:9.5pt;color:#4b5563;margin-top:2px}\n.entry-meta span{margin-right:12px;white-space:nowrap}\n/* The spans of a meta line are separated by a real space in the markup as\n   well as by that margin: a margin is invisible to the PDF's text stream, so\n   spacing alone prints \"04/2022 - PresentAustin, TX\" to anything reading it. */\nul.achievements{margin:5px 0 0 16px}\nul.achievements li{margin-bottom:2px;color:#111827}\n</style>\n</head>\n<body>\n<div class=\"header\">\n<div class=\"name\">{{name}}</div>\n<div class=\"headline\">{{title}}</div>\n<div class=\"contact\"><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.64 4.55 2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.09 6.09l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z\"/></svg>{{contact.phone}}</span><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg>{{contact.email}}</span>{{#if contact.linkedin}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg>{{contact.linkedin}}</span>{{/if}}{{#if contact.github}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg>{{contact.github}}</span>{{/if}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>{{contact.location}}</span></div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Summary</div>\n<div class=\"summary-text\">{{summary}}</div>\n</div>\n\n<div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"section-title\">Education</div>\n{{#each education}}\n<div class=\"entry\">\n<div class=\"entry-title\">{{degree}}</div>\n<div class=\"entry-org\">{{institution}}</div>\n<div class=\"entry-meta\"><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg>{{startDate}} - {{endDate}}</span>{{#if location}} <span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>{{location}}</span>{{/if}}{{#if gpa}} <span>GPA: {{gpa}}</span>{{/if}}</div>\n</div>\n{{/each}}\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Skills</div>\n<div class=\"skills-line\">{{#if skillCategories.[0].category}}{{#each skillCategories}}<div class=\"skill-category\"><div class=\"skill-category-title\">{{category}}</div><div class=\"skill-category-skills\">{{join skills \", \"}}</div></div>{{/each}}{{else}}{{#if hardSkills.length}}{{#each hardSkills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{/if}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Professional Experience</div>\n{{#each experience}}\n<div class=\"entry\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"entry-title\">{{title}}</div>\n<div class=\"entry-org\">{{company}}</div>\n<div class=\"entry-meta\"><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg>{{startDate}} - {{endDate}}</span>{{#if location}} <span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>{{location}}</span>{{/if}}</div>\n</div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n</div>\n{{/each}}\n</div>\n\n{{#if certifications.length}}\n<div class=\"section\">\n<div class=\"section-title\">Certifications</div>\n{{#each certifications}}\n<div class=\"entry\">\n<div class=\"entry-title\">{{name}}</div>\n{{#if issuer}}<div class=\"entry-org\">{{issuer}}</div>{{/if}}\n{{#if date}}<div class=\"entry-meta\"><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg>{{date}}</span></div>{{/if}}\n</div>\n{{/each}}\n</div>\n{{/if}}\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "education",
    "hardSkills",
    "experience",
    "certifications"
  ],
