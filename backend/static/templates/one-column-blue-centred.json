{
  "id": "one-column-blue-centred",
  "name": "blue_centred_one_column",
  "description": "One column with a blue masthead: the name centred in small caps between a thin rule and a double rule, contact details on one line split by diamonds, and section headings centred in blue small caps with a rule running out on each side. Skills print as two columns of bullets when flat, one group per line when grouped. Work history leads with the title and dates, then the company and location. Sections are summary, skills, work history and education.",
  "disabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n<style>\n@page{margin:0.5in 0.6in}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{background:#ffffff}\nbody{font-family:Georgia,'Times New Roman',Times,serif;font-size:10.5pt;line-height:1.4;color:#1a1a1a}\n/* Masthead: a rule above, the name in blue small caps, a double rule below. */\n.header{text-align:center;margin-bottom:12px}\n.rule-top{border-top:1px solid #1e88d6;margin-bottom:14px}\n.name{font-size:21pt;font-weight:700;font-variant:small-caps;letter-spacing:0.5px;color:#1e88d6;line-height:1.1}\n.headline{font-size:11pt;color:#1e88d6;margin-top:3px}\n.rule-double{border-top:1px solid #1e88d6;border-bottom:3px solid #1e88d6;height:7px;margin:10px 0 8px}\n.contact-line{font-size:9.5pt;color:#1a1a1a}\n.contact-line>span:not(:last-child)::after{content:\"\\00a0\\25C6\\00a0\";font-size:0.75em;vertical-align:0.1em}\n/* Headings centred in blue small caps, a thin rule running out on each side. */\n.section{margin-bottom:12px}\n.section-title{display:flex;align-items:center;gap:12px;font-size:12pt;font-variant:small-caps;\n  letter-spacing:0.4px;color:#1e88d6;margin-bottom:8px;break-after:avoid}\n.section-title::before,.section-title::after{content:\"\";flex:1;border-top:1px solid #1e88d6}\n.summary-text{text-align:left}\n/* A flat skills list prints as two columns of bullets; grouped skills one group per line. */\nul.skills-list{margin:0 0 0 22px}\nul.skills-list.flat{columns:2;column-gap:36px}\nul.skills-list li{margin-bottom:3px;break-inside:avoid}\n.skill-category-title::before{content:none}\n.skill-category-title,.skill-category-skills{display:inline;margin:0;padding:0}\n.skill-category-title{font-weight:700}\n.skill-category-title::after{content:\":\\00a0\"}\n.entry{margin-bottom:10px}\n.entry:last-child{margin-bottom:0}\n.job-title,.company-name,.edu-degree,.edu-institution{font-weight:700}\n.job-line,.company-line,.edu-line{font-size:10.5pt}\nul.achievements{margin:2px 0 0 22px}\nul.achievements li{margin-bottom:1px}\n</style>\n</head>\n<body data-section-order=\"summary,skills,experience,education\">\n<div class=\"header\">\n<div class=\"rule-top\"></div>\n<div class=\"name\">{{name}}</div>\n{{#if title}}<div class=\"headline\">{{title}}</div>{{/if}}\n<div class=\"rule-double\"></div>\n<div class=\"contact-line\">{{#if contact.location}}<span>{{contact.location}}</span>{{/if}}{{#if contact.phone}}<span>{{contact.phone}}</span>{{/if}}{{#if contact.email}}<span>{{contact.email}}</span>{{/if}}{{#if contact.linkedin}}<span>{{contact.linkedin}}</span>{{/if}}{{#if contact.github}}<span>{{contact.github}}</span>{{/if}}{{#if contact.portfolio}}<span>{{contact.portfolio}}</span>{{/if}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Professional Summary</div>\n<div class=\"summary-text\">{{summary}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Skills</div>\n{{#if skillCategories.[0].category}}<ul class=\"skills-list\">{{#each skillCategories}}<li><span class=\"skill-category-title\">{{category}}</span><span class=\"skill-category-skills\">{{join skills \", \"}}</span></li>{{/each}}</ul>{{else}}<ul class=\"skills-list flat\">{{#if hardSkills.length}}{{#each hardSkills}}<li>{{this}}</li>{{/each}}{{else}}{{#each skills}}<li>{{this}}</li>{{/each}}{{/if}}</ul>{{/if}}\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Work History</div>\n{{#each experience}}\n<div class=\"entry\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"job-line\"><span class=\"job-title\">{{title}}</span>, <span class=\"job-date\">{{startDate}} to {{endDate}}</span></div>\n{{#if company}}<div class=\"company-line\"><span class=\"company-name\">{{company}}</span>{{#if location}} – <span class=\"entry-location\">{{location}}</span>{{/if}}</div>{{/if}}\n</div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n</div>\n{{/each}}\n</div>\n\n<div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"section-title\">Education</div>\n{{#each education}}\n<div class=\"entry edu-item\">\n<div class=\"edu-line\"><span class=\"edu-degree\">{{degree}}</span>{{#if endDate}}, {{endDate}}{{/if}}{{#if gpa}}, GPA {{gpa}}{{/if}}</div>\n{{#if institution}}<div class=\"edu-line\"><span class=\"edu-institution\">{{institution}}</span>{{#if location}} - {{location}}{{/if}}</div>{{/if}}\n</div>\n{{/each}}\n</div>\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "hardSkills",
    "experience",
    "education"
  ],
  "createdAt": "2026-10-29T03:32:21.043Z",
  "updatedAt": "2026-10-29T03:32:21.043Z"
