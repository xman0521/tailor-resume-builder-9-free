{
  "id": "two-column-navy",
  "name": "Two-Column Navy",
  "description": "Dark navy professional 2-column layout with gold accents",
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n  <style>\n    @page{margin:0.3in}\n    *{margin:0;padding:0;box-sizing:border-box}\n    body{font-family:Georgia,serif;font-size: 12px;line-height:1.3;color:#1e293b}\n    .header{text-align:center;margin-bottom:10px;padding-bottom:8px;border-bottom:3px double #0f172a}\n    .name{font-size: 26px;font-weight:bold;color:#0f172a}\n    .title{font-size: 20px;color:#475569}\n    .contact{font-size: 12px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px}\n    .contact a{color:#000;text-decoration:none}\n    .main-container{display:flex;gap:16px}\n    .left-column{flex:0 0 62%}\n    .right-column{flex:0 0 35%}\n    .section{margin-bottom:8px}\n    .section-title{font-size: 16px;font-weight:bold;color:#0f172a;text-transform:uppercase;border-left:4px solid #c9a227;padding-left:6px;margin-bottom:5px}\n    .summary{text-align:justify;color:#334155}\n    .job-title{font-weight:bold;font-size: 16px;color:#0f172a}\n    .company-line{display:flex;justify-content:space-between;font-size: 12px;color:#64748b;margin-bottom:2px}\n    .achievements{padding-left:14px;font-size: 12px}\n    .skills-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 10px}\n    .skill-box{font-size: 12px;padding:4px 8px;background:#f8fafc;border:1px solid #e2e8f0;color:#374151;display:flex;align-items:center;justify-content:center;text-align:center}\n    .strength-title{font-weight:bold;font-size: 16px;color:#0f172a}\n    .strength-description{font-size: 12px;color:#475569}\n    .degree{font-weight:bold;font-size: 16px;color:#0f172a}\n    .institution,.edu-date{font-size: 12px;color:#64748b}\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <div class=\"name\">{{name}}</div>\n    <div class=\"title\">{{title}}</div>\n    <div class=\"contact\">\n      <span>📞 {{contact.phone}}</span>\n      <span>✉ {{contact.email}}</span>\n      {{#if contact.linkedin}}<span>🔗 <a href=\"{{contact.linkedin}}\">{{contact.linkedin}}</a></span>{{/if}}\n      <span>📍 {{contact.location}}</span>\n    </div>\n  </div>\n  <div class=\"main-container\">\n    <div class=\"left-column\">\n      <div class=\"section\"><div class=\"section-title\">Summary</div><div class=\"summary\">{{summary}}</div></div>\n      <div class=\"section\">\n        <div class=\"section-title\">Professional Experience</div>\n        {{#each experience}}\n        <div style=\"margin-bottom:8px\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n          <div class=\"job-title\">{{title}}</div>\n          <div class=\"company-line\"><span>{{company}}</span><span>{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</span></div>\n          <div>{{description}}</div>\n          </div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n        </div>\n        {{/each}}\n      </div>\n    </div>\n    <div class=\"right-column\">\n      {{#if strengths.length}}\n      <div class=\"section\">\n        <div class=\"section-title\">Strengths</div>\n        {{#each strengths}}\n        <div style=\"margin-bottom:6px\"><div class=\"strength-title\">{{title}}</div><div class=\"strength-description\">{{description}}</div></div>\n        {{/each}}\n      </div>\n      {{/if}}\n      <div class=\"section\">\n        <div class=\"section-title\">Hard Skills</div>\n        <div class=\"skills-grid\">{{#if hardSkills.length}}{{#each hardSkills}}<div class=\"skill-box\">{{this}}</div>{{/each}}{{else}}{{#each skills}}<div class=\"skill-box\">{{this}}</div>{{/each}}{{/if}}</div>\n      </div>\n      {{#if softSkills.length}}\n      <div class=\"section\">\n        <div class=\"section-title\">Soft Skills</div>\n        <div class=\"skills-grid\">{{#each softSkills}}<div class=\"skill-box\">{{this}}</div>{{/each}}</div>\n      </div>\n      {{/if}}\n      <div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n        <div class=\"section-title\">Education</div>\n        {{#each education}}\n        <div style=\"margin-bottom:6px;break-inside:avoid;page-break-inside:avoid\"><div class=\"degree\">{{degree}}</div><div class=\"institution\">{{institution}}</div><div class=\"edu-date\">{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</div></div>\n        {{/each}}\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "experience",
    "strengths",
    "hardSkills",
    "softSkills",
    "education"
  ]
}
