{
  "id": "one-column-modern",
  "name": "One-Column Modern",
  "description": "1-column ATS-friendly resume template with compact timeline headers and modern section accents",
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n  <style>\n    @page {\n      margin: 0.35in;\n    }\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    body {\n      font-family: Calibri, 'Segoe UI', Arial, sans-serif;\n      font-size: 8.2pt;\n      line-height: 1.3;\n      color: #0b1324;\n    }\n    .section:last-child {\n      margin-bottom: 0;\n    }\n    .header {\n      margin-bottom: 10px;\n      border: 1px solid #cbd5e1;\n      border-left: 5px solid #2563eb;\n      padding: 8px 10px;\n      background: #f8fafc;\n    }\n    .name {\n      font-size: 21pt;\n      font-weight: bold;\n      color: #0f172a;\n    }\n    .title {\n      font-size: 9pt;\n      color: #334155;\n      margin-top: 2px;\n      margin-bottom: 5px;\n    }\n    .contact {\n      font-size: 7.4pt;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      color: #1e293b;\n    }\n    .contact-item {\n      display: inline-flex;\n      align-items: center;\n      gap: 3px;\n    }\n    .contact a {\n      color: #000;\n      text-decoration: none;\n    }\n    .section {\n      margin-bottom: 9px;\n    }\n    .section-title {\n      font-size: 7.6pt;\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      color: #1e3a8a;\n      margin-bottom: 4px;\n    }\n    .summary {\n      color: #334155;\n      text-align: justify;\n    }\n    .experience-item {margin-bottom: 7px;padding-bottom: 6px;border-bottom: 1px dashed #d1d5db;}\n    .experience-item:last-child {\n      border-bottom: none;\n      padding-bottom: 0;\n    }\n    .exp-header {\n      display: flex;\n      justify-content: space-between;\n      gap: 8px;\n      font-size: 7.6pt;\n      color: #475569;\n      margin-bottom: 1px;\n    }\n    .job-title {\n      font-size: 8.8pt;\n      font-weight: bold;\n      color: #0f172a;\n    }\n    .description {\n      font-size: 7.9pt;\n      margin-bottom: 2px;\n      color: #334155;\n    }\n    .achievements {\n      padding-left: 14px;\n      font-size: 7.6pt;\n      color: #0f172a;\n    }\n    .achievements li {\n      margin-bottom: 1px;\n    }\n    .skills-list {\n      display: block;\n      color: #1f2937;\n    }\n    .skills-list span {\n      display: inline;\n    }\n    .strength-item {\n      margin-bottom: 5px;\n    }\n    .strength-title {\n      font-size: 7.9pt;\n      font-weight: bold;\n      color: #0f172a;\n    }\n    .strength-description {\n      font-size: 7.5pt;\n      color: #475569;\n    }\n    .education-item {\n      margin-bottom: 5px;\n    break-inside:avoid;page-break-inside:avoid}\n    .degree {\n      font-size: 7.9pt;\n      font-weight: bold;\n    }\n    .institution {\n      font-size: 7.6pt;\n      color: #334155;\n    }\n    .edu-date {\n      font-size: 7.3pt;\n      color: #64748b;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <div class=\"name\">{{name}}</div>\n    <div class=\"title\">{{title}}</div>\n    <div class=\"contact\">\n      <span class=\"contact-item\">📞 {{contact.phone}}</span>\n      <span class=\"contact-item\">✉ {{contact.email}}</span>\n      {{#if contact.linkedin}}<span class=\"contact-item\">🔗 <a href=\"{{contact.linkedin}}\">{{contact.linkedin}}</a></span>{{/if}}\n      <span class=\"contact-item\">📍 {{contact.location}}</span>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-title\">Summary</div>\n    <div class=\"summary\">{{summary}}</div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-title\">Hard Skills</div>\n    <div class=\"skills-list\">\n      {{#if hardSkills.length}}\n      {{#each hardSkills}}<span>{{this}}{{#unless @last}} • {{/unless}}</span>{{/each}}\n      {{else}}\n      {{#each skills}}<span>{{this}}{{#unless @last}} • {{/unless}}</span>{{/each}}\n      {{/if}}\n    </div>\n  </div>\n\n  {{#if softSkills.length}}\n  <div class=\"section\">\n    <div class=\"section-title\">Soft Skills</div>\n    <div class=\"skills-list\">\n      {{#each softSkills}}<span>{{this}}{{#unless @last}} • {{/unless}}</span>{{/each}}\n    </div>\n  </div>\n  {{/if}}\n\n  {{#if strengths.length}}\n  <div class=\"section\">\n    <div class=\"section-title\">Strengths</div>\n    {{#each strengths}}\n    <div class=\"strength-item\">\n      <div class=\"strength-title\">{{title}}</div>\n      <div class=\"strength-description\">{{description}}</div>\n    </div>\n    {{/each}}\n  </div>\n  {{/if}}\n\n  <div class=\"section\">\n    <div class=\"section-title\">Professional Experience</div>\n    {{#each experience}}\n    <div class=\"experience-item\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n      <div class=\"job-title\">{{title}}</div>\n      <div class=\"exp-header\">\n        <span>{{company}}</span>\n        <span>{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</span>\n      </div>\n      <div class=\"description\">{{description}}</div>\n      </div><ul class=\"achievements\">\n        {{#each achievements}}\n        <li>{{this}}</li>\n        {{/each}}\n      </ul>\n    </div>\n    {{/each}}\n  </div>\n\n  <div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n  <div class=\"section-title\">Education</div>\n    {{#each education}}\n    <div class=\"education-item\">\n      <div class=\"degree\">{{degree}}</div>\n      <div class=\"institution\">{{institution}}</div>\n      <div class=\"edu-date\">{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</div>\n    </div>\n    {{/each}}\n  </div>\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "hardSkills",
    "softSkills",
    "strengths",
    "experience",
    "education"
  ],
