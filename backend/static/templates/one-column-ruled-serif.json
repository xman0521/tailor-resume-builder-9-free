{
  "id": "one-column-ruled-serif",
  "name": "ruled_serif_one_column",
  "description": "A clean one column in serif: a centred name and title with a line of contact icons under it, then left-aligned uppercase headings each on a heavy rule. Entries lead with the role, with dates and location right-aligned opposite. Sections are summary, education, skills and professional experience only - no certificates or languages block.",
  "disabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n<style>\n@page{margin:0.55in 0.6in}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{background:#ffffff}\nbody{font-family:Georgia,'Times New Roman',Times,serif;font-size:10.5pt;line-height:1.45;color:#1a1a1a}\n/* The masthead is the only centred thing on the page. */\n.header{text-align:center;margin-bottom:14px}\n.name{font-size:20pt;font-weight:700;color:#1f3864;line-height:1.15}\n.headline{font-size:12pt;font-style:italic;color:#333333;margin-top:2px}\n.contact{font-size:9.5pt;color:#1a1a1a;margin-top:8px}\n.contact span{margin-right:14px;white-space:nowrap}\n.contact svg{color:#1f3864}\n.section{margin-bottom:12px}\n.section-title{font-size:11.5pt;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;\n  color:#1f3864;border-bottom:2px solid #1a1a1a;padding-bottom:2px;margin-bottom:7px}\n.summary-text{text-align:left}\n/* Each entry is a left block and a right block, side by side. The right one is\n   a sibling, never a float, so the separator pass can measure the pair. */\n.entry{margin-bottom:9px}\n.entry:last-child{margin-bottom:0}\n.entry-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}\n.entry-left{min-width:0}\n.entry-right{text-align:right;white-space:nowrap;font-size:9.5pt}\n.job-title,.edu-degree{font-weight:700;font-size:10.8pt}\n.company-name,.edu-institution{font-style:italic;font-size:10.3pt}\nul.achievements{margin:3px 0 0 16px}\nul.achievements li{margin-bottom:1px}\nul.skills-list{margin:0 0 0 16px}\nul.skills-list li{margin-bottom:2px}\n/* One group per bullet, so both halves stay on the line whichever of the six\n   render-time looks is drawn over them - those are written for a block per\n   group, and a block inside this list would break the bullet across two lines. */\n/* NO SECOND MARKER. The six render-time looks are written for a block per\n   group; one of them (\"marker\") puts a small square before the heading. In this\n   template each group is a LIST ITEM, so the list already draws a marker and the\n   square printed beside it - \"- * AI & LLM ENGINEERING:\" - which is what the\n   operator saw. The colon below is this template's own and already beats the\n   \"inline\" look's middle dot, because the template's stylesheet is written after\n   the render-time one. */\n.skill-category-title::before{content:none}\n.skill-category-title,.skill-category-skills{display:inline;color:#1a1a1a;margin:0;padding:0}\n.skill-category-title{font-weight:700}\n.skill-category-title::after{content:\":\"}\n.skill-category-skills{font-weight:400}\n</style>\n</head>\n<body>\n<div class=\"header\">\n<div class=\"name\">{{name}}</div>\n<div class=\"headline\">{{title}}</div>\n<div class=\"contact\"><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>{{contact.location}}</span><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg>{{contact.email}}</span><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.64 4.55 2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.09 6.09l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z\"/></svg>{{contact.phone}}</span>{{#if contact.linkedin}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"/><circle cx=\"4\" cy=\"4\" r=\"2\"/><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"/></svg>{{contact.linkedin}}</span>{{/if}}{{#if contact.github}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"/><circle cx=\"4\" cy=\"4\" r=\"2\"/><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"/></svg>{{contact.github}}</span>{{/if}}{{#if contact.portfolio}}<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align:-1px;margin-right:4px\"><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"/><circle cx=\"4\" cy=\"4\" r=\"2\"/><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"/></svg>{{contact.portfolio}}</span>{{/if}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Summary</div>\n<div class=\"summary-text\">{{summary}}</div>\n</div>\n\n<div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"section-title\">Education</div>\n{{#each education}}\n<div class=\"entry edu-item\">\n<div class=\"entry-head\">\n<div class=\"entry-left\">\n<div class=\"edu-degree\">{{degree}}</div>\n{{#if institution}}<div class=\"edu-institution\">{{institution}}</div>{{/if}}\n</div>\n<div class=\"entry-right\"><div class=\"job-date\">{{startDate}}{{#if endDate}} - {{endDate}}{{/if}}</div>{{#if location}}<div class=\"entry-location\">{{location}}</div>{{/if}}{{#if gpa}}<div class=\"entry-location\">GPA: {{gpa}}</div>{{/if}}</div>\n</div>\n</div>\n{{/each}}\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Skills</div>\n<ul class=\"skills-list\">{{#if skillCategories.[0].category}}{{#each skillCategories}}<li><span class=\"skill-category-title\">{{category}}</span> <span class=\"skill-category-skills\">{{join skills \", \"}}</span></li>{{/each}}{{else}}{{#if hardSkills.length}}{{#each hardSkills}}<li>{{this}}</li>{{/each}}{{else}}{{#each skills}}<li>{{this}}</li>{{/each}}{{/if}}{{/if}}</ul>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Professional Experience</div>\n{{#each experience}}\n<div class=\"entry\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"entry-head\">\n<div class=\"entry-left\">\n<div class=\"job-title\">{{title}}</div>\n{{#if company}}<div class=\"company-name\">{{company}}</div>{{/if}}\n</div>\n<div class=\"entry-right\"><div class=\"job-date\">{{startDate}} - {{endDate}}</div>{{#if location}}<div class=\"entry-location\">{{location}}</div>{{/if}}</div>\n</div>\n</div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n</div>\n{{/each}}\n</div>\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "education",
    "hardSkills",
    "experience"
  ],
  "createdAt": "2026-10-13T04:42:52.488Z",
  "updatedAt": "2026-10-14T12:16:29.688879Z"
}
