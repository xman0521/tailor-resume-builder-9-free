{
  "id": "one-column-accent-bar",
  "name": "accent_bar_one_column",
  "description": "One column marked in its margins instead of divided by rules: a short rust bar above each section label, a stripe down the left of every entry, square bullets, set in Corbel. Sections run summary, education, skills, experience.",
  "disabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\"><title>{{name}} - Resume</title>\n<style>\n@page{margin:0.55in 0.65in}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{background:#ffffff}\nbody{font-family:Corbel,Candara,'Segoe UI',Arial,sans-serif;font-size:10.5pt;line-height:1.45;color:#1c1917}\n.header{margin-bottom:16px}\n.name{font-size:24pt;font-weight:700;letter-spacing:0.2px;line-height:1.1;color:#1c1917}\n.headline{font-size:12pt;font-weight:600;color:#9a3412;margin-top:2px}\n.contact{font-size:9.5pt;color:#44403c;margin-top:6px}\n.section{margin-bottom:14px}\n/* THE DEVICE: a short bar ABOVE the heading instead of a rule under it. Drawn\n   with an empty ::before, so it is a box and not a character - generated text\n   WOULD go into the PDF's stream, and \"- EDUCATION\" no longer starts with the\n   word a parser is looking for. */\n.section-title{font-size:10.5pt;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#1c1917;margin-bottom:7px}\n.section-title::before{content:\"\";display:block;width:2.4em;height:3px;background:#9a3412;margin-bottom:5px}\n.summary-text{color:#292524}\n.skill-category{margin-bottom:4px}\n.skill-category-title,.skill-category-skills{color:#1c1917}\n.skill-category-title{font-weight:700;font-size:9.5pt;text-transform:uppercase;letter-spacing:0.7px}\n.skill-category-skills{font-weight:400;letter-spacing:normal}\n/* ...and a stripe down the left of each role, which is the same idea at entry\n   scale: the page is marked in its margins rather than divided by rules. */\n.exp-item{border-left:2px solid #d6d3d1;padding-left:11px;margin-bottom:11px}\n.exp-item:last-child{margin-bottom:0}\n.job-title{font-weight:700;font-size:11pt;color:#9a3412}\n.job-meta{font-size:9.5pt;color:#44403c;margin-top:1px}\nul.achievements{margin:4px 0 0 16px;list-style:square}\nul.achievements li{margin-bottom:3px;padding-left:2px}\n.edu-item,.cert-item{border-left:2px solid #d6d3d1;padding-left:11px;margin-bottom:7px}\n.edu-item:last-child,.cert-item:last-child{margin-bottom:0}\n.edu-degree{font-weight:700}\n.edu-meta{font-size:9.5pt;color:#44403c}\n</style>\n</head>\n<body>\n<div class=\"header\">\n<div class=\"name\">{{name}}</div>\n<div class=\"headline\">{{title}}</div>\n<div class=\"contact\">{{contact.phone}} | {{contact.email}}{{#if contact.linkedin}} | {{contact.linkedin}}{{/if}}{{#if contact.github}} | {{contact.github}}{{/if}}{{#if contact.portfolio}} | {{contact.portfolio}}{{/if}} | {{contact.location}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Summary</div>\n<div class=\"summary-text\">{{summary}}</div>\n</div>\n\n<div class=\"section\" style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"section-title\">Education</div>\n{{#each education}}\n<div class=\"edu-item\">\n<div class=\"edu-degree\">{{degree}}</div>\n<div class=\"edu-meta\">{{institution}}{{#if location}} | {{location}}{{/if}} | {{startDate}} - {{endDate}}{{#if gpa}} | GPA: {{gpa}}{{/if}}</div>\n</div>\n{{/each}}\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Skills</div>\n<div class=\"skills-line\">{{#if skillCategories.[0].category}}{{#each skillCategories}}<div class=\"skill-category\"><div class=\"skill-category-title\">{{category}}</div><div class=\"skill-category-skills\">{{join skills \", \"}}</div></div>{{/each}}{{else}}{{#if hardSkills.length}}{{#each hardSkills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{/if}}</div>\n</div>\n\n<div class=\"section\">\n<div class=\"section-title\">Experience</div>\n{{#each experience}}\n<div class=\"exp-item\"><div style=\"break-inside:avoid;page-break-inside:avoid\">\n<div class=\"job-title\">{{title}}</div>\n<div class=\"job-meta\">{{company}}{{#if location}} | {{location}}{{/if}} | {{startDate}} - {{endDate}}</div>\n</div><ul class=\"achievements\">{{#each achievements}}<li>{{this}}</li>{{/each}}</ul>\n</div>\n{{/each}}\n</div>\n\n{{#if certifications.length}}\n<div class=\"section\">\n<div class=\"section-title\">Certifications</div>\n{{#each certifications}}\n<div class=\"cert-item\"><span class=\"edu-degree\">{{name}}</span>{{#if issuer}} | {{issuer}}{{/if}}{{#if date}} | {{date}}{{/if}}</div>\n{{/each}}\n</div>\n{{/if}}\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "education",
    "hardSkills",
    "experience",
    "certifications"
  ],
  "createdAt": "2026-10-12T04:08:53.123Z",
  "updatedAt": "2026-10-12T04:08:53.123Z"
}
