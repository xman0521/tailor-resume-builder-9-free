{
  "name": "resume-builder-backend",
  "version": "1.0.0",
  "description": "Backend for the tailored resume builder (Express + SQLite)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --watch src --ignore-watch static --ignore-watch dist --ignore-watch generated --ignore-watch ../generated --ignore-watch .git src/index.ts",
    "dev:poll": "ts-node-dev --poll --interval 1000 --respawn --transpile-only --watch src --ignore-watch static --ignore-watch dist --ignore-watch generated --ignore-watch ../generated --ignore-watch .git src/index.ts",
    "build": "tsc",
    "postinstall": "node scripts/installBrowser.js --if-missing",
    "setup:browser": "node scripts/installBrowser.js",
    "browser:debug": "npm run build && node dist/scripts/launchDebugBrowsers.js",
    "browser:doctor": "npm run build && node dist/scripts/browserChatDoctor.js",
    "start": "node dist/index.js",
    "migrate:legacy": "npm run build && node dist/scripts/migrateLegacyData.js",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "ai:rollback": "npm run build && node dist/scripts/rollbackProviderMigration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "apify-client": "^2.23.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "handlebars": "^4.7.8",
    "html-to-docx": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.22.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.2.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
